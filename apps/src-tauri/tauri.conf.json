{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible",
  "version": "0.1.0",
  "identifier": "com.bemedev.bible",
  "build": {
    "frontendDist": "../web/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @bemedev/bible-web dev",
    "beforeBuildCommand": "pnpm --filter @bemedev/bible-web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bible Reader & Semantic Search",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
